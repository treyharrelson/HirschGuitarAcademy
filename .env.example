# Copy this file to .env and fill in your values.
# don't touch db_host or db_port
# if anything changed, you need to redo the docker server by deleting the old container
#  and deleting pgdata, then run docker compose up

POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=hirsh_guitar_db

DB_HOST=localhost
DB_PORT=5432

# Railway vars for shared development environment
DATABASE_URL=
NODE_ENV=production
PORT=3000
SESSION_SECRET=
CORS_ORIGIN=https://localhost:5173
# Cloudflare R2 vars for file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=